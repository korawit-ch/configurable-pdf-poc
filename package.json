{
  "name": "configurable-pdf-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "verify:pdf": "node --import tsx scripts/verify-pdf.ts",
    "format": "prettier --write src scripts index.html package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@pdfme/generator": "latest",
    "@pdfme/jsx": "latest",
    "@pdfme/schemas": "latest",
    "antd": "^6.0.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "description": "A standalone configurable PDF prototype with live previews, reorderable sections, and JSON export."
}
